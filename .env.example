# ── Database ─────────────────────────────────────────────────────────────
# Optional. Unset → embedded PGlite in ./data/pglite (zero setup).
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# PGLITE_DIR=./data/pglite

# ── LLM (any OpenAI-compatible endpoint; all editable later in Settings) ──
# Gemini (free tier):
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
# LLM_CONTEXT_TOKENS=16000
LLM_MODEL=gemini-3.5-flash-lite
# Local FreeLLMAPI instead:
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:3001/v1
# LLM_API_KEY=freellmapi-...
# LLM_MODEL=gemini-2.5-flash
# Offline UI development: node scripts/mock-llm.mjs, then
# LLM_BASE_URL=http://127.0.0.1:3099/v1  LLM_MODEL=mock

# ── Firecrawl: local first (3 s timeout), cloud fallback ─────────────────
FIRECRAWL_URL=http://localhost:3002
FIRECRAWL_API_KEY=
# ── Workspace & host access (defaults are the safe ones; Settings → Access toggles these) ──
FIRECRAWL_CLOUD_URL=https://api.firecrawl.dev
WORKSPACE_DIR=./workspace
# sandbox | home | full
ACCESS_MODE=sandbox
# sandbox | host
TERMINAL_MODE=sandbox
# 1 = allow sudo in host terminal
ALLOW_SUDO=0
# SUDO_PASSWORD=           # only if sudo needs a password; never stored in the DB
