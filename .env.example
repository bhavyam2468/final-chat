# Configuration for running from source (`npm run dev`) — copy to .env.
#
# The desktop application does not use this file. It reads the same keys from
# <data>/config.env, which it seeds with a commented template on first run; see
# docs/DESKTOP.md. Real environment variables win over both files.

# ── Database ─────────────────────────────────────────────────────────────
# Unset → embedded PGlite in ./data/pglite (zero setup).
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# PGLITE_DIR=./data/pglite

# ── LLM (any OpenAI-compatible endpoint) ─────────────────────────────────
# Gemini (free tier):
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# LLM_CONTEXT_TOKENS=16000
# Tokens one request may use even when the model window is bigger (1M windows otherwise resend everything each step)
# LLM_WORKING_TOKENS=64000
# 1 = model accepts images (view_image, screenshots); 0 = text-only
# LLM_VISION=1
# Local FreeLLMAPI / Ollama instead:
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# ── Web research: local-first discovery + browser-free extraction ─────────
# Leave unset to use the SearXNG the desktop app starts for itself; set this to
# point at your own instance.
# SEARXNG_URL=http://127.0.0.1:8080
# Firecrawl remains available for difficult JS/anti-bot pages, but is off by default.
FIRECRAWL_ENABLED=0
FIRECRAWL_URL=http://localhost:3002
FIRECRAWL_API_KEY=
FIRECRAWL_CLOUD_URL=https://api.firecrawl.dev

# ── Workspace & host access (safe defaults; Settings → Access) ───────────
WORKSPACE_DIR=./workspace
# sandbox | home | full
ACCESS_MODE=sandbox
# sandbox | host
TERMINAL_MODE=sandbox
# 1 = allow sudo in the host terminal (needs TERMINAL_MODE=host)
ALLOW_SUDO=0
# SUDO_PASSWORD=           # only if sudo needs a password; never stored in the DB
# off = hosted deployment: host access can never be enabled from Settings
# HOST_ACCESS=off

# ── Agent ────────────────────────────────────────────────────────────────
# fix (lint UI files, one repair round) | warn | off
# QUALITY_GUARD=fix

# ── Tool binaries (auto-detected; set only to override) ──────────────────
# Chrome/Chromium for the browser/screenshot tool
# CHROME_PATH=/usr/bin/chromium
# Python for run_python; default is ./.venv (the desktop app provisions its own), else python3
# PYTHON_BIN=/usr/bin/python3
# VENV_DIR=./.venv

# ── Server ───────────────────────────────────────────────────────────────
# The desktop shell picks a free port at every launch and records it in
# <data>/runtime.json; these only apply when running the server yourself.
# PORT=3000
# APP_URL=http://localhost:3000
# 1 = developer mode: mock model, sample files, window.__dev (see docs/BLOCKS.md)
# DEV_MODE=0
# Offline UI development without a model: DEV_MODE=1, then __dev.mock() in the
# console, or run `node dev/mock-llm.mjs 3099` and set
# LLM_BASE_URL=http://127.0.0.1:3099/v1  LLM_MODEL=mock
