# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# LLM Provider (FreeLLMAPI or any OpenAI-compatible endpoint)
LLM_BASE_URL=http://localhost:3001/v1
LLM_API_KEY=freellmapi-<your-key-here>
LLM_MODEL=gemini-2.5-flash

# Firecrawl — hybrid: local for free scraping, cloud for bot bypass & AI extraction
FIRECRAWL_URL=http://localhost:3002
FIRECRAWL_API_KEY=fc-<your-cloud-key-here>
FIRECRAWL_CLOUD_URL=https://api.firecrawl.dev

# Workspace
WORKSPACE_DIR=./workspace
ACCESS_MODE=sandbox
