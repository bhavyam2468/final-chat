{
  "name": "minimalist-ai-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run typecheck && npm run lint",
    "test:unit": "node --experimental-strip-types --no-warnings dev/tests/run.mjs",
    "test:e2e": "node dev/blocks-e2e.mjs",
    "desktop:icons": "node scripts/desktop/icons.mjs",
    "desktop:searxng": "node scripts/desktop/provision-searxng.mjs",
    "desktop:prepare": "node scripts/desktop/prepare.mjs",
    "desktop:smoke": "node scripts/desktop/smoke.mjs",
    "desktop:appimage": "tauri build --bundles appimage",
    "desktop:build": "tauri build",
    "desktop:dev": "tauri dev",
    "desktop:check": "npm run test:unit && npm run typecheck && npm run lint && npm run build && npm run desktop:prepare -- --skip-build && npm run desktop:smoke"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@highlightjs/cdn-assets": "^11.10.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@mozilla/readability": "^0.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "3dmol": "^2.4.2",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "geist": "^1.7.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "leaflet": "^1.9.4",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.48.0",
    "lucide-static": "^0.469.0",
    "mammoth": "^1.12.3",
    "marked": "^18.0.14",
    "mermaid": "^11.17.2",
    "nanoid": "^6.0.1",
    "next": "16.2.6",
    "node-tikzjax": "^1.0.5",
    "pg": "8.20.0",
    "puppeteer-core": "^24.43.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "smiles-drawer": "^2.0.1",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
