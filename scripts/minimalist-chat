#!/usr/bin/env bash
# Launcher installed by setup.sh to ~/.local/bin/minimalist-chat (@APP@ and @PORT@ are filled in there).
set -e
APP="@APP@"
PORT="$(grep -s '^PORT=' "$APP/.env" | cut -d= -f2)"; PORT="${PORT:-@PORT@}"
URL="http://localhost:$PORT"
BROWSER_BIN="${CHAT_BROWSER:-$(grep -s '^CHAT_BROWSER=' "$APP/.env" | cut -d= -f2-)}"
svc() { if [ "$(uname -s)" = Darwin ]; then case "$1" in start) launchctl load ~/Library/LaunchAgents/com.minimalist-chat.plist ;; stop) launchctl unload ~/Library/LaunchAgents/com.minimalist-chat.plist ;; restart) svc stop; svc start ;; status) launchctl list | grep minimalist-chat ;; esac; else systemctl --user "$1" minimalist-chat ${2:-}; fi; }

case "${1:-open}" in
  start|stop|restart) svc "$1"; echo "$1: ok" ;;
  status) svc status --no-pager ;;
  logs) if [ "$(uname -s)" = Darwin ]; then tail -f ~/Library/Logs/minimalist-chat.log; else journalctl --user -u minimalist-chat -f; fi ;;
  update) cd "$APP" && git pull --ff-only && ./setup.sh --yes ;;
  open)
    curl -fs -o /dev/null "$URL/api/health" || svc start
    for _ in $(seq 1 40); do curl -fs -o /dev/null "$URL/api/health" && break; sleep 0.5; done
    if [ -n "$BROWSER_BIN" ] && command -v "$BROWSER_BIN" >/dev/null 2>&1; then exec "$BROWSER_BIN" --new-window "$URL"
    elif command -v xdg-open >/dev/null; then exec xdg-open "$URL"; else exec open "$URL"; fi ;;
  *) echo "Usage: minimalist-chat [open|start|stop|restart|status|logs|update]"; exit 1 ;;
esac
