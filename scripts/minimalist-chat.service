# Template: setup.sh writes the filled-in copy to ~/.config/systemd/user/minimalist-chat.service
[Unit]
Description=Minimalist AI Chat Workspace
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=@APP@
EnvironmentFile=-@APP@/.env
Environment=NODE_ENV=production
Environment=PATH=@PATH@
@PRE@
# Bound to localhost: the agent can have host terminal access, which must never be reachable from the network.
ExecStart=@NPM@ start -- -H @HOST@ -p @PORT@
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
