{
  "servers": {
    "filesystem": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "${HOME}"], "enabled": false },
    "github": { "url": "https://api.githubcopilot.com/mcp/", "headers": { "Authorization": "Bearer ${GITHUB_TOKEN}" }, "enabled": false },
    "postgres": { "command": "npx", "args": ["-y", "@modelcontextprotocol/server-postgres", "${DATABASE_URL}"], "enabled": false },
    "pdf-reader": { "command": "npx", "args": ["-y", "@sylphx/pdf-reader-mcp"], "enabled": false },
    "papers": { "command": "uvx", "args": ["--from", "paper-search-mcp", "python", "-m", "paper_search_mcp.server"], "enabled": false },
    "chroma": { "command": "uvx", "args": ["chroma-mcp", "--client-type", "persistent", "--data-dir", "./.chroma"], "enabled": false }
  }
}
